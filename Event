    let currentWeek = 'pair';

    function renderCalendar() {
      const calendar = document.getElementById('calendar');
      const data = CALENDAR_DATA[currentWeek];

      const days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
      const times = ['00h', '01h', '03h', '06h', '09h', '12h', '13h', '15h', '16h', '19h', '20h', '22h', '23h'];

      let html = '<div class="header-cell"></div>';
      days.forEach(day => {
        html += `<div class="header-cell">${day}</div>`;
      });

      times.forEach(time => {
        html += `<div class="time-cell">${time}</div>`;

        days.forEach(day => {
          const items = data[day][time] || [];

          const bosses = items.filter(item => ['normal', 'ascendant', 'archiboss'].includes(item.type));
          const events = items.filter(item => item.type === 'event');

          let cellContent = '';

          bosses.forEach(boss => {
            const logo = getLogo(boss.name, boss.type);
            const logoClass = boss.type === 'archiboss' ? 'archiboss' : (boss.type === 'ascendant' ? 'ascendant' : '');

            cellContent += `
              <div class="boss-item ${boss.type}">
                <img src="${logo}" alt="${boss.name}" class="boss-logo ${logoClass}" onerror="this.style.display='none'" />
                <span class="boss-name">${boss.name}</span>
              </div>
            `;
          });

          if (events.length > 0) {
            cellContent += '<div class="event-icons">';
            events.forEach(event => {
              const iconUrl = EVENT_ICONS[event.name] || "";
              if (iconUrl) {
                cellContent += `
                  <div class="event-icon" data-tooltip="${event.name}">
                    <img src="${iconUrl}" alt="${event.name}" />
                  </div>
                `;
              }
            });
            cellContent += '</div>';
          }

          html += `<div class="event-cell">${cellContent}</div>`;
        });
      });

      calendar.innerHTML = html;
    }

    function switchWeek(week) {
      currentWeek = week;
      document.querySelectorAll('.week-toggle button').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`btn-${week}`).classList.add('active');
      renderCalendar();
    }

    renderCalendar();
